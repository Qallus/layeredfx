# Public homepage: no API credentials required. Keep indexing disabled during review.
ALLOW_INDEXING=false
NEXT_PUBLIC_SITE_URL=https://layeredfx.com

# Local development defaults to browser-only synthetic demo data.
# Set supabase to exercise the authenticated API during local development.
# Production ALWAYS requires the authenticated adapter; "demo" cannot bypass it.
LFX_OPERATIONS_MODE=demo

# SEPARATE LAYEREDFX SUPABASE PROJECT ONLY. Never copy Channel Cast / ControlP secrets.
# These variables are server-only. Never prefix a service key with NEXT_PUBLIC_.
LFX_SUPABASE_URL=
LFX_SUPABASE_ANON_KEY=
LFX_SUPABASE_SERVICE_ROLE_KEY=
LFX_OPERATIONS_ORG_ID=

# Optional additional exact origins, comma separated; no wildcards.
# The site origin above is allowed automatically. Localhost:3000 is allowed in dev.
# Example when accepting writes from both domain forms:
LFX_ALLOWED_ORIGINS=https://www.layeredfx.com

# Optional LayeredFX-only Twilio account. Never reuse Channel Cast credentials.
# SMS and outgoing call history require the first three values.
LFX_TWILIO_ACCOUNT_SID=
LFX_TWILIO_AUTH_TOKEN=
LFX_TWILIO_PHONE_NUMBER=
# Browser voice additionally requires an API key and a TwiML App pointing to
# the exact public HTTPS webhook URL below (POST). Incoming calls are not enabled.
LFX_TWILIO_API_KEY_SID=
LFX_TWILIO_API_KEY_SECRET=
LFX_TWILIO_TWIML_APP_SID=
LFX_TWILIO_VOICE_WEBHOOK_URL=

# LayeredFX email through Resend (server-only). The sending domain must be verified in Resend.
# Booking emails use the editable "Booking:" templates in Dashboard > Communications > Templates.
LFX_RESEND_API_KEY=
LFX_EMAIL_FROM="LayeredFX <hello@layeredfx.com>"
LFX_EMAIL_REPLY_TO=hello@layeredfx.com
# Team inbox for new, changed and canceled booking alerts. Leave empty to skip team alerts.
LFX_BOOKING_ALERT_EMAIL=

# Portal previews exist only during development. Set supabase to test live auth.
# Production always requires Supabase; this setting cannot enable a production demo.
LFX_PORTAL_MODE=demo

# Wall Studio request assignment and OpenStreetMap-compatible travel services
# Active staff/admin member receiving authenticated customer studio requests.
LFX_STUDIO_LEAD_OWNER_ID=
# Nominatim-compatible private address geocoder and OSRM-compatible router.
# Use a self-hosted or contracted provider; public Nominatim must not receive customer addresses.
LFX_STUDIO_GEOCODER_URL=
LFX_STUDIO_ROUTER_URL=

# AI agents (server-only; never NEXT_PUBLIC_). Dashboard > Agents > Setup shows which are set, never the values.
# Eve on Hermes Agent: LFX_HERMES_API_KEY is the Hermes API_SERVER_KEY.
LFX_HERMES_URL=https://agent.layeredfx.com
LFX_HERMES_API_KEY=
# Hermes reports the profile name as the model name, so this is Eve's profile.
LFX_HERMES_MODEL=eve
# Paperclip agent teams: an agent API key created in Paperclip, plus the company id.
LFX_PAPERCLIP_URL=https://team.layeredfx.com
LFX_PAPERCLIP_API_KEY=
LFX_PAPERCLIP_COMPANY_ID=
LFX_PAPERCLIP_AGENT_ID=
# xAI Voice Agent API
LFX_XAI_API_KEY=
LFX_XAI_VOICE_MODEL=grok-voice-latest
LFX_XAI_VOICE=eve
